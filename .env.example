# ──────────────────────────────────────────
# DevinetteLab — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ──────────────────────────────────────────

# Clé API Anthropic (Claude)
# Obtenir sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# URL du frontend (pour CORS en production)
FRONTEND_URL=https://devinettelab.vercel.app

# URL du renderer Remotion (Node.js) — Phase 2
RENDERER_URL=http://localhost:3001

# Environnement
ENVIRONMENT=development

# ── Phase 3 — TikTok OAuth ─────────────────
# Créer une app sur https://developers.tiktok.com/
# Scopes requis : user.info.basic, video.publish, video.upload
TIKTOK_CLIENT_ID=your_client_id_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Phase 3 — Base de données ───────────────
# SQLite (dev) ou PostgreSQL (prod)
DATABASE_URL=sqlite:///./devinette.db
# DATABASE_URL=postgresql://user:password@localhost:5432/devinette

# ── Phase 3 — JWT ───────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-generate-a-random-32-char-string

# ── Phase 3 — Email (notifications) ─────────
# Gmail : activer "Mots de passe d'application" dans les paramètres
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=DevinetteLab <your@gmail.com>

# ── Phase 3 — Stockage vidéos planifiées ─────
VIDEO_STORAGE_PATH=/tmp/devinettelab-scheduled
